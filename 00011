#include <iostream>
#include <vector> // Required for dynamic arrays
using namespace std;
int main() {
    int n;
    cout << "Enter the number of elements: ";
    cin >> n;
if (n < 2) {
        cout << "Array is too small to compare neighbors." << endl;
        return 0;
    }
    vector<int> arr(n);
    cout << "Enter " << n << " numbers:" << endl;
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    int count = 0;
for(int i = 0; i < n - 1; i++) {
        if (arr[i] < arr[i+1]) {
            count++;
        }
    }       
    
    cout << "Count where current < next: " << count;
    
    return 0;
}